# Plantilla de variables de la API. Copiar a `.env` para desarrollo local.
#
# NUNCA se commitea un `.env` con valores: `.gitignore` lo excluye. Los valores
# reales viven en tres sitios distintos y no se mezclan:
#
#   LOCAL  `.env` en el equipo de cada uno (Mongo local o cluster de PRE propio)
#   PRE    variables de entorno del servicio de Render PRE
#   PRO    `.env` del servidor con PM2
#
# Este fichero solo documenta QUÉ hace falta. Un valor de PRO no se pega jamás
# en PRE ni al contrario: son clusters, claves de Stripe y buckets distintos.

# --- MongoDB -----------------------------------------------------------------
# La URI la monta `scripts/_mongo-uri.js`. Dos formas, excluyentes:
#   a) MONGODB_URI completa (gana sobre todo lo demás)
#   b) MONGODB_CLUSTER + MONGODB_DB + MONGODB_USER + MONGODB_PASS (Atlas), o
#      MONGODB_HOST + MONGODB_PORT + MONGODB_DB (local)
# PRE y PRO apuntan a CLUSTERS DISTINTOS. Es el único sitio donde se decide.
MONGODB_URI=
MONGODB_CLUSTER=
MONGODB_DB=
MONGODB_USER=
MONGODB_PASS=
MONGODB_HOST=
MONGODB_PORT=
MONGODB_SESSION_STORAGE=
# Fuerzan una de las dos formas cuando están definidas las dos (1 / true).
MONGODB_PREFER_CLUSTER=
MONGODB_PREFER_HOST=
# Timeouts de conexión en ms (por defecto 30000 los dos).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=
MONGODB_CONNECT_TIMEOUT_MS=

# --- Servidor ----------------------------------------------------------------
# NODE_ENV sin definir = CORS cerrado (el default seguro). `development` abre
# cualquier puerto de localhost; con CORS_OPEN=1 además cualquier origen.
# En PRE y PRO se dejan las dos SIN definir.
NODE_ENV=
CORS_OPEN=
SERVER_PORT=
SERVER_DOMAIN=
LOGGUER=

# --- Autenticación -----------------------------------------------------------
# Par RSA en PEM para firmar y verificar los JWT. PRE y PRO usan pares
# DISTINTOS: un token de PRE no debe valer en PRO.
PRIVATE_KEY=
PUBLIC_KEY=
JWT_ISSUER=
JWT_ALLOWED_AUDIENCES=
REFRESH_COOKIE_NAME=
COOKIE_SECURE=
COOKIE_SAMESITE=
# Login social.
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
APPLE_ALLOWED_AUDIENCES=
# Base de los enlaces de verificación por correo.
VERIFY_BASE_URL=

# --- Correo (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Remitente de los correos a usuarios (por defecto registro@trainfit.net).
FROM_EMAIL=
# Respuestas de los usuarios a esos correos (por defecto soporte@trainfit.net).
SUPPORT_EMAIL=
# Remitente de los avisos internos (por defecto avisos@trainfit.net).
NOTIFICATIONS_FROM_EMAIL=
# Destino de los avisos internos de registro y de las sugerencias (obligatorio
# el primero; las sugerencias van ahí si no se indica otro).
REGISTRATION_NOTIFICATION_EMAIL=
SUGGESTIONS_NOTIFICATION_EMAIL=
REGISTRATION_NOTIFICATION_TIME_ZONE=

# --- Suscripciones de cliente (RevenueCat) -----------------------------------
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=
BILLING_RECONCILIATION_CRON=

# --- Facturación de trainers (Stripe) ----------------------------------------
# Sin STRIPE_KEY la facturación está apagada (los entrenadores quedan en Free).
# El prefijo de la clave decide el entorno: rk_test_ / sk_test_ = sandbox
# (LOCAL y PRE), rk_live_ = real (PRO, solo clave restringida). Nunca se cruzan:
# un webhook firmado con el secreto de test no valida en PRO y al revés.
# Los precios no se configuran aquí: se buscan en Stripe por lookup key
# (`npm run stripe:catalog` los crea). El IVA lo gestiona Managed Payments.
STRIPE_KEY=
# Secreto del destino de webhook (o el que imprime `stripe listen` en local).
STRIPE_WEBHOOK_SECRET=
# Web de Trainers: vuelta de Checkout y del portal, enlaces de los avisos.
STRIPE_RETURN_URL=http://localhost:8100
# Condiciones de contratación y buzón de facturación (obligatorios en PRO).
# La URL es la versión que acepta cada entrenador: nunca se edita una publicada,
# se publica otra (p. ej. https://trainfit.net/condiciones-trainers/2026-10/).
STRIPE_TERMS_URL=
STRIPE_SUPPORT_EMAIL=

# --- Multimedia (R2 + Bunny Stream) ------------------------------------------
# Sin credenciales se usa disco local (MEDIA_LOCAL=1), solo para desarrollo.
MEDIA_LOCAL=
MEDIA_LOCAL_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOST=
BUNNY_CDN_TOKEN_KEY=

# --- Otros -------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Solo para `scripts/delete-exercise-by-name.js`: URI de PRO usada desde un
# equipo local. No se pone en PRE ni en el propio servidor de PRO.
MONGODB_URI_PRO=
