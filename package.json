    "rebuild:search-indexes": "node scripts/rebuild-search-indexes.js",
    "rebuild:search-indexes:dry-run": "node scripts/rebuild-search-indexes.js --dry-run",
    "migrate:dietday-dates": "node scripts/migrate-dietday-dates.js",
    "migrate:dietday-dates:dry-run": "node scripts/migrate-dietday-dates.js --dry-run",
    "migrate:dietday-unique": "node scripts/migrate-dietday-unique-date.js",
    "migrate:dietday-unique:dry-run": "node scripts/migrate-dietday-unique-date.js --dry-run",
    "migrate:tables": "node scripts/migrate-tables-unify.js",
    "migrate:nutritional-goals": "node scripts/migrate-nutritional-goals.js",
    "migrate:nutritional-goals:dry-run": "node scripts/migrate-nutritional-goals.js --dry-run",
    "migrate:sets-cardio-fields": "node scripts/migrate-sets-cardio-fields.js",
