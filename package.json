{
  "name": "trainfitback",
  "version": "101.3.49",
  "private": true,
  "scripts": {
    "prepare": "node .githooks/install.js",
    "lint": "eslint --quiet .",
    "lint:report": "eslint .",
    "lint:fix": "eslint --fix .",
    "verify": "npm run lint && npm test",
    "start": "node ./bin/www",
    "serve": "cross-env NODE_ENV=development node --watch bin/www",
    "serve:open": "cross-env NODE_ENV=development CORS_OPEN=1 node --watch bin/www",
    "rebuild:indexes": "npm run build:trainer-billing && node scripts/rebuild-indexes.js",
    "rebuild:indexes:dry-run": "npm run build:trainer-billing && node scripts/rebuild-indexes.js --dry-run",
    "migrate": "npm run build:ts && node scripts/migrate-modelo-datos.js",
    "migrate:dry-run": "npm run build:ts && node scripts/migrate-modelo-datos.js --dry-run",
    "presets": "npm run build:ts && node scripts/presets.js",
    "presets:dry-run": "npm run build:ts && node scripts/presets.js --dry-run",
    "test": "node --test \"components/**/*.test.js\" \"middleware/**/*.test.js\" \"scripts/**/*.test.js\" \"integration/**/*.test.js\"",
    "pretest:integration": "npm run build:ts",
    "test:integration": "node --test \"integration/**/*.test.js\"",
    "delete:exercise": "node scripts/delete-exercise-by-name.js",
    "delete:curl-21": "node scripts/delete-exercise-by-name.js \"Curl 21\"",
    "delete:curl-21:apply": "node scripts/delete-exercise-by-name.js \"Curl 21\" --apply",
    "build:trainer-billing": "tsc -p tsconfig.trainer-billing.json",
    "build:trainer-payments": "tsc -p tsconfig.trainer-payments.json",
    "build:ts": "npm run build:trainer-billing && npm run build:trainer-payments",
    "prestart": "npm run build:ts",
    "preserve": "npm run build:ts",
    "preserve:open": "npm run build:ts",
    "pretest": "npm run build:ts",
    "test:trainer-billing": "npm run build:trainer-billing && node --test components/trainerBilling/*.test.js components/billing/feature-access.test.js components/trainerClients/trainer-seat-service.test.js",
    "stripe:catalog": "npm run build:trainer-billing && node scripts/stripe-sync-catalog.js",
    "stripe:catalog:dry-run": "npm run build:trainer-billing && node scripts/stripe-sync-catalog.js --dry-run",
    "media:preflight": "node scripts/media-preflight.js",
    "billing:preflight": "npm run build:trainer-billing && node scripts/trainer-billing-preflight.js",
    "test:trainer-payments:db": "npm run build:trainer-payments && node --test --test-concurrency=1 components/trainerPayments/trainer-payments-db.test.js"
  },
  "dependencies": {
    "@awaitjs/express": "^0.6.1",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@types/node": "22.18.6",
    "axios": "^1.7.9",
    "bcrypt": "^5.0.1",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.0.1",
    "express": "^4.18.2",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "mongodb": "^4.4.1",
    "mongoose": "^6.2.9",
    "mongoose-autopopulate": "^0.16.1",
    "morgan": "~1.9.1",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.7.5",
    "semver": "^7.8.5",
    "stripe": "22.6.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "debug": "~2.6.9",
    "eslint": "^8.57.1",
    "mongodb-memory-server-core": "^10.4.3"
  }
}
