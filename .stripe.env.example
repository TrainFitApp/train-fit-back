# Pagos de Trainers (Stripe): plantilla de variables. Sin valores reales: nunca subas claves al repo.
#
# Un entorno lleva UN solo bloque (sandbox o real); los nombres son los mismos en los dos.
# El modo lo decide el prefijo de STRIPE_KEY:
#   rk_test_ / sk_test_  → sandbox
#   rk_live_             → real (sk_live_ se rechaza: en el servidor solo claves restringidas)
#   vacía o sin poner    → facturación apagada (freno de emergencia: quitarla y reiniciar)
# Las cinco STRIPE_* tienen que ser de la MISMA cuenta que la clave: un secreto de webhook de la
# otra cuenta hace fallar la firma de todos los eventos.
# Guía completa: docs/stripe-trainers-guia.md (C2 y C3).


# ======================================================================================
# SANDBOX → PRE (variables de entorno del servicio en Render) o tu .env local
# Cuenta Stripe: «Entorno de prueba de TrainFit» (selector de cuenta, arriba a la izquierda).
# Ojo: el .env local y PRE usan la BD `pre`, compartida y con cuentas reales.
# ======================================================================================

# Desarrolladores → Claves de API → «Crear clave restringida».
STRIPE_KEY=rk_test_xxxxxxxxxxxxxxxx

# Desarrolladores → Webhooks → el endpoint que apunta a
# https://<back de PRE>/api/billing/webhooks/stripe → «Secreto de firma».
# En local: el whsec_ que imprime `stripe listen --forward-to localhost:3000/api/billing/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Web de Trainers a la que vuelve Stripe tras pagar (solo origen, sin ruta).
# En local vale http://localhost:8100; en PRE, la URL https de Cloudflare.
STRIPE_RETURN_URL=http://localhost:8100

# Opcionales en sandbox (si se ponen, deben ser válidas).
STRIPE_TERMS_URL=
STRIPE_SUPPORT_EMAIL=

# Web de Trainers de PRE si no está ya entre los orígenes permitidos (solo https exactos, sin ruta).
CORS_EXTRA_ORIGINS=


# ======================================================================================
# REAL → PRO (el .env del back en Hetzner, el que usa PM2)
# Cuenta Stripe: la real (sin sandbox). Tras cambiarlo: pm2 reload train-fit-back.
# Primera vez: todo esto SIN STRIPE_KEY, luego migrate:trainer-seats, stripe:catalog y
# billing:preflight, y al final STRIPE_KEY (guía, C3).
# ======================================================================================

# STRIPE_KEY=rk_live_xxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx      # endpoint hacia https://server.trainfit.net/api/billing/webhooks/stripe
# STRIPE_RETURN_URL=https://trainers.trainfit.net   # obligatorio https
# STRIPE_TERMS_URL=https://<URL de las condiciones> # obligatoria en real
# STRIPE_SUPPORT_EMAIL=facturacion@trainfit.net     # obligatoria en real
# CORS_EXTRA_ORIGINS=https://trainers.trainfit.net


# ======================================================================================
# NO van en ningún .env
# ======================================================================================
# STRIPE_CATALOG_KEY: clave con escritura en Products y Prices, solo para `npm run stripe:catalog`
#   (una vez por cuenta y cuando cambie un precio). Se pone en la sesión de la terminal y se borra:
#     PowerShell:  $env:STRIPE_CATALOG_KEY = Read-Host "Clave de Stripe"   …   Remove-Item Env:STRIPE_CATALOG_KEY
# Los IDs de productos y precios: el back los busca por lookup key (src/catalog.ts).
# Ninguna clave va en el front.
#
# Relacionadas (ya en el .env general): RESEND_API_KEY y FROM_EMAIL envían el aviso de renovación anual.
