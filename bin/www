require("dotenv").config();
const mongoose = require("mongoose");
mongoose.set("strictQuery", true);
const app = require("../app");
const { buildMongoUri, redactMongoUri } = require("../scripts/_mongo-uri");

// -------------------------------------------------------
// 🧩 Normalización del puerto
// -------------------------------------------------------
function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) return val; // named pipe
  if (port >= 0) return port; // port number
  return false;
}

const port = normalizePort(process.env.SERVER_PORT || 3000);
app.set("port", port);

// -------------------------------------------------------
// 🔧 Variables de entorno
// -------------------------------------------------------
const serverDomain = process.env.SERVER_DOMAIN;

// -------------------------------------------------------
// ⚙️ Construcción de la URI de conexión
// -------------------------------------------------------
const mongoURI = buildMongoUri();
const redactedMongoURI = redactMongoUri(mongoURI);
const mongoConnectOptions = {
  serverSelectionTimeoutMS: Number(
    process.env.MONGODB_SERVER_SELECTION_TIMEOUT_MS || 30000,
  ),
  connectTimeoutMS: Number(process.env.MONGODB_CONNECT_TIMEOUT_MS || 30000),
};

// -------------------------------------------------------
// 🚀 Conexión y arranque del servidor
// -------------------------------------------------------
mongoose.Promise = global.Promise;
console.log(`🔌 Connecting to MongoDB: ${redactedMongoURI}`);
mongoose
  .connect(mongoURI, mongoConnectOptions)
  .then(() => {
    console.log("✅ Conexión a la base de datos establecida con éxito");
    console.log(`🔗 Mongo URI: ${redactedMongoURI}`);

    // Crear servidor Express
    const serv = app.listen(port, () => {
      console.log(`🌍 Server domain: ${serverDomain}`);
      console.log(`🚀 Server running at port: ${port}`);
    });

    serv.timeout = 300000; // 5 minutos para soportar la IA
  })
  .catch((err) => {
    console.error("❌ Error al conectar con MongoDB:");
    console.error(err);
    process.exit(1);
  });
