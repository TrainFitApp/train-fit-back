# Plantilla de variables de la API. Copiar a `.env` para desarrollo local.
#
# NUNCA se commitea un `.env` con valores: `.gitignore` lo excluye. Los valores
# reales viven en tres sitios distintos y no se mezclan:
#
#   LOCAL  `.env` en el equipo de cada uno (Mongo local o cluster de PRE propio)
#   PRE    variables de entorno del servicio de Render PRE
#   PRO    `.env` del servidor con PM2
#
# Este fichero solo documenta QUÉ hace falta. Un valor de PRO no se pega jamás
# en PRE ni al contrario: son clusters, claves de Stripe y buckets distintos.

# --- MongoDB -----------------------------------------------------------------
# La URI la monta `scripts/_mongo-uri.js`. Dos formas, excluyentes:
#   a) MONGODB_URI completa (gana sobre todo lo demás)
#   b) MONGODB_CLUSTER + MONGODB_DB + MONGODB_USER + MONGODB_PASS (Atlas), o
#      MONGODB_HOST + MONGODB_PORT + MONGODB_DB (local)
# PRE y PRO apuntan a CLUSTERS DISTINTOS. Es el único sitio donde se decide.
MONGODB_URI=
MONGODB_CLUSTER=
MONGODB_DB=
MONGODB_USER=
MONGODB_PASS=
MONGODB_HOST=
MONGODB_PORT=
MONGODB_SESSION_STORAGE=
# Fuerzan una de las dos formas cuando están definidas las dos (1 / true).
MONGODB_PREFER_CLUSTER=
MONGODB_PREFER_HOST=
# Timeouts de conexión en ms (por defecto 30000 los dos).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=
MONGODB_CONNECT_TIMEOUT_MS=

# --- Servidor ----------------------------------------------------------------
# NODE_ENV sin definir = CORS cerrado (el default seguro). `development` abre
# cualquier puerto de localhost; con CORS_OPEN=1 además cualquier origen.
# En PRE y PRO se dejan las dos SIN definir.
NODE_ENV=
CORS_OPEN=
SERVER_PORT=
SERVER_DOMAIN=
LOGGUER=

# --- Autenticación -----------------------------------------------------------
# Par RSA en PEM para firmar y verificar los JWT. PRE y PRO usan pares
# DISTINTOS: un token de PRE no debe valer en PRO.
PRIVATE_KEY=
PUBLIC_KEY=
JWT_ISSUER=
JWT_ALLOWED_AUDIENCES=
REFRESH_COOKIE_NAME=
COOKIE_SECURE=
COOKIE_SAMESITE=
# Login social.
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
APPLE_ALLOWED_AUDIENCES=
# Base de los enlaces de verificación por correo.
VERIFY_BASE_URL=

# --- Correo ------------------------------------------------------------------
FROM_EMAIL=
SES_REGION=
SES_SMTP_USER=
SES_SMTP_PASS=
REGISTER_MAIL_SENDER_HOST=
REGISTER_MAIL_SENDER_PORT=
REGISTER_MAIL_SENDER_USER=
REGISTER_MAIL_SENDER_PASS=
SUGGESTIONS_MAIL_SENDER_HOST=
SUGGESTIONS_MAIL_SENDER_PORT=
SUGGESTIONS_MAIL_SENDER_USER=
SUGGESTIONS_MAIL_SENDER_PASS=
REGISTRATION_NOTIFICATION_EMAIL=
REGISTRATION_NOTIFICATION_TIME_ZONE=

# --- Suscripciones de cliente (RevenueCat) -----------------------------------
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_TRAINER_PRO_ENTITLEMENT_ID=
REVENUECAT_TRAINER_UNLIMITED_ENTITLEMENT_ID=
BILLING_RECONCILIATION_CRON=

# --- Facturación de trainers (Stripe) ----------------------------------------
# PRE usa claves de test de Stripe; PRO las live. Nunca se cruzan: un webhook
# firmado con el secreto de test no valida en PRO y al revés.
TRAINER_BILLING_ENABLED=
TRAINER_BILLING_FRONTEND_URL=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MANAGED=
STRIPE_TRAINER_PORTAL_CONFIGURATION_ID=
STRIPE_TRAINER_PRO_MONTHLY_PRICE_ID=
STRIPE_TRAINER_PRO_ANNUAL_PRICE_ID=
STRIPE_TRAINER_GROWTH_MONTHLY_PRICE_ID=
STRIPE_TRAINER_GROWTH_ANNUAL_PRICE_ID=
STRIPE_TRAINER_SCALE_MONTHLY_PRICE_ID=
STRIPE_TRAINER_SCALE_ANNUAL_PRICE_ID=

# --- Multimedia (R2 + Bunny Stream) ------------------------------------------
# Sin credenciales se usa disco local (MEDIA_LOCAL=1), solo para desarrollo.
MEDIA_LOCAL=
MEDIA_LOCAL_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOST=
BUNNY_CDN_TOKEN_KEY=

# --- Otros -------------------------------------------------------------------
DEEPSEEK_API_KEY=
DISABLE_INVITE_REMINDER_CRON=
# Solo para `scripts/delete-exercise-by-name.js`: URI de PRO usada desde un
# equipo local. No se pone en PRE ni en el propio servidor de PRO.
MONGODB_URI_PRO=
