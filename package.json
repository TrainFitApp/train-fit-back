    "migrate:exercise-muscles": "node scripts/migrate-exercise-muscles.js",
    "migrate:exercise-muscles:dry-run": "node scripts/migrate-exercise-muscles.js --dry-run --verbose",
    "migrate:exercise-isometric": "node scripts/migrate-exercise-isometric.js",
    "migrate:exercise-isometric:dry-run": "node scripts/migrate-exercise-isometric.js --dry-run",
    "test": "node --test \"components/**/*.test.js\" \"services/**/*.test.js\" \"middleware/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test2": "node --test \"components/**/*.test.js\" \"services/**/*.test.js\" \"middleware/**/*.test.js\" \"scripts/**/*.test.js\"",
    "reset:weeks": "node scripts/reset-weeks.js",
    "reset:weeks:dry-run": "node scripts/reset-weeks.js --dry-run",
    "delete:exercise": "node scripts/delete-exercise-by-name.js",
    "delete:curl-21": "node scripts/delete-exercise-by-name.js \"Curl 21\"",
    "delete:curl-21:apply": "node scripts/delete-exercise-by-name.js \"Curl 21\" --apply",
    "migrate:diet-phases": "node scripts/migrate-diet-phases.js",
    "migrate:diet-phases:dry-run": "node scripts/migrate-diet-phases.js --dry-run",
    "migrate:meal-alternatives-default": "node scripts/migrate-meal-alternatives-default.js",
    "migrate:meal-alternatives-default:dry-run": "node scripts/migrate-meal-alternatives-default.js --dry-run",
    "build:trainer-billing": "tsc -p tsconfig.trainer-billing.json",
    "build:trainer-payments": "tsc -p tsconfig.trainer-payments.json",
    "build:ts": "npm run build:trainer-billing && npm run build:trainer-payments",
    "prestart": "npm run build:ts",
    "preserve": "npm run build:ts",
    "preserve:open": "npm run build:ts",
    "pretest": "npm run build:ts",
    "test:trainer-billing": "npm run build:trainer-billing && node --test components/trainerBilling/*.test.js components/billing/feature-access-service.test.js components/trainerClients/trainer-seat-service.test.js",
    "stripe:local": "npm run build:ts && node scripts/stripe-local.js",
    "media:preflight": "node scripts/media-preflight.js",
    "billing:preflight": "node scripts/trainer-billing-preflight.js",
    "test:trainer-payments:db": "npm run build:trainer-payments && node --test --test-concurrency=1 components/trainerPayments/trainer-payments-db.test.js",
    "migrate:trainer-payments": "npm run build:trainer-payments && node scripts/migrate-trainer-payments-v2.js",
    "migrate:trainer-payments:dry-run": "npm run build:trainer-payments && node scripts/migrate-trainer-payments-v2.js --dry-run"
