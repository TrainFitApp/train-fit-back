require("dotenv").config();
const mongoose = require("mongoose");
mongoose.set("strictQuery", true);
const app = require("../app");

// -------------------------------------------------------
// 🧩 Normalización del puerto
// -------------------------------------------------------
function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) return val; // named pipe
  if (port >= 0) return port; // port number
  return false;
}

const port = normalizePort(process.env.PORT || process.env.SERVER_PORT || 3000);
app.set("port", port);

// -------------------------------------------------------
// 🔧 Variables de entorno
// -------------------------------------------------------
const mongoDBUser = process.env.MONGODB_USER || process.env.MONGOUSER;
const mongoDBPass = process.env.MONGODB_PASS || process.env.MONGOPASSWORD;
const mongoDBCluster = process.env.MONGODB_CLUSTER || process.env.MONGOHOST;
const mongoDBHost = process.env.MONGODB_HOST;
const mongoDBPort = process.env.MONGODB_PORT || process.env.MONGOPORT;
const mongoDBDB = process.env.MONGODB_DB || process.env.MONGODATABASE || "trainfit";
const serverDomain = process.env.SERVER_DOMAIN;

// -------------------------------------------------------
// ⚙️ Construcción de la URI de conexión
// -------------------------------------------------------
let mongoURI;

if (process.env.MONGODB_URI || process.env.MONGODB_URL) {
  // 🚂 Conexión por URI completa (Recomendado para Railway/Producción)
  mongoURI = process.env.MONGODB_URI || process.env.MONGODB_URL;
} else if (mongoDBCluster && !mongoDBCluster.includes("localhost") && !mongoDBCluster.includes("127.0.0.1")) {
  // ☁️ Conexión Atlas (Producción externa via Cluster)
  mongoURI = `mongodb+srv://${mongoDBUser}:${mongoDBPass}@${mongoDBCluster}.mongodb.net/${mongoDBDB || "trainfit"}`;
} else if (mongoDBHost || mongoDBCluster) {
  // 🧩 Conexión estándar (Local o Red Privada)
  const host = mongoDBHost || mongoDBCluster;
  const auth = (mongoDBUser && mongoDBPass) ? `${mongoDBUser}:${mongoDBPass}@` : "";
  const port = mongoDBPort ? `:${mongoDBPort}` : "";
  mongoURI = `mongodb://${auth}${host}${port}/${mongoDBDB || "trainfit"}`;
} else {
  // ⚠️ Fallback de seguridad
  mongoURI = "mongodb://localhost:27017/trainfit";
  console.warn("⚠️ Advertencia: No se encontraron variables de MongoDB. Usando backup local.");
}

// -------------------------------------------------------
// 🚀 Conexión y arranque del servidor
// -------------------------------------------------------
mongoose.Promise = global.Promise;
mongoose
  .connect(mongoURI)
  .then(() => {
    console.log("✅ Conexión a la base de datos establecida con éxito");
    console.log(`🔗 Mongo URI: ${mongoURI}`);

    // Crear servidor Express
    const serv = app.listen(port, () => {
      console.log(`🌍 Server domain: ${serverDomain}`);
      console.log(`🚀 Server running at port: ${port}`);
    });

    serv.timeout = 30000;
  })
  .catch((err) => {
    console.error("❌ Error al conectar con MongoDB:");
    console.error(err);
  });
