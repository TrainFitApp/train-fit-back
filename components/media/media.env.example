# Fotos y vídeos (docs/plan-medidas-multimedia.md). Copia estas líneas al
# .env del servidor (o al tuyo local para probar contra R2/Bunny) y rellénalas.
# Sin ellas, en desarrollo se usa el disco local (.media-local/).
# Comprobar después con: npm run media:preflight

# Cloudflare R2 › Overview (Account ID) y Manage R2 API Tokens (Object Read & Write, solo este bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trainfit-media
# eu si el bucket se creó con jurisdicción UE; none si no
R2_JURISDICTION=eu

# Bunny Stream: una sola librería para clientes y entrenadores (trainfit-dev
# en local, trainfit-pro en el servidor). Library ID, API Key y CDN Hostname en la pestaña API de la librería;
# la clave del token en su pestaña Security › Token authentication key.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
BUNNY_CDN_TOKEN_KEY=

# Opcional: una librería por tipo (p. ej. para dar 1080p solo a la biblioteca
# de técnica). Si se rellena el LIBRARY_ID de un bloque,
# ese tipo usa su bloque entero en vez del genérico de arriba.
# Clientes (revisiones y vídeos de progreso, 360p/720p):
# BUNNY_CLIENT_LIBRARY_ID=
# BUNNY_CLIENT_API_KEY=
# BUNNY_CLIENT_CDN_HOST=
# BUNNY_CLIENT_CDN_TOKEN_KEY=
# Entrenadores (biblioteca de técnica, 480p/720p/1080p):
# BUNNY_TRAINER_LIBRARY_ID=
# BUNNY_TRAINER_API_KEY=
# BUNNY_TRAINER_CDN_HOST=
# BUNNY_TRAINER_CDN_TOKEN_KEY=
