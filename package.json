    "migrate:weights-to-anthropometry:dry-run": "node scripts/migrate-weights-to-anthropometry.js --dry-run",
    "migrate:normalize-emails": "node scripts/migrate-normalize-emails.js",
    "migrate:normalize-emails:dry-run": "node scripts/migrate-normalize-emails.js --dry-run",
    "migrate:nutrition-model": "node scripts/migrate-nutrition-model.js",
    "migrate:nutrition-model:dry-run": "node scripts/migrate-nutrition-model.js --dry-run",
    "migrate:nutrition-model:keep-old": "node scripts/migrate-nutrition-model.js --keep-old",
    "verify:nutrition-model": "node scripts/verify-nutrition-model.js",
    "migrate:pautado-assigned-quantity": "node scripts/migrate-pautado-assigned-quantity.js",
