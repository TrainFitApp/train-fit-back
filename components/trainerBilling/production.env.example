# Pagos de Trainers en PRODUCCIÓN: añadir al .env del servidor (el que carga PM2 con bin/www).
# No sustituye al .env: MONGODB_URI, SERVER_PORT, JWT, SES, RevenueCat… se quedan como están.
# Nunca en Git, en el front ni en el .env local (apunta a pre). Todo sale del modo LIVE de Stripe:
# los identificadores de test no valen. Pasos: docs/stripe-trainers-guia.md (A1–A9 y C2).

# 0 hasta que `npm run billing:preflight` salga sin fallos; después 1 y reiniciar PM2.
TRAINER_BILLING_ENABLED=0
TRAINER_BILLING_MODE=live
# managed_payments (01/10/2026): Stripe vende a través de Link y gestiona el IVA (+3,5 % por transacción).
# stripe_tax: TrainFit vende y Stripe Tax calcula el IVA; exige NIF con IVA y el registro de España (guía, A4).
TRAINER_BILLING_TAX_POLICY=managed_payments
# Origen exacto de la web de Trainers: https, sin ruta ni barra final (dominio pendiente de confirmar).
TRAINER_BILLING_FRONTEND_URL=https://trainers.trainfit.net
# La misma URL que en Stripe → Configuración → Datos públicos.
TRAINER_BILLING_TERMS_URL=https://
TRAINER_BILLING_SUPPORT_EMAIL=facturacion@trainfit.net

# Clave API RESTRINGIDA (Desarrolladores → Claves API → Crear clave restringida). Empieza por rk_live_.
# La clave secreta sk_live_ NO vale aquí ni en ningún otro sitio de este fichero: el backend la rechaza.
STRIPE_KEY=rk_live_
# Secreto de firma del webhook (Desarrolladores → Webhooks → el destino live → Secreto de firma).
# Empieza por whsec_. No es una clave API. El de `stripe listen` no sirve.
STRIPE_WEBHOOK_SECRET=whsec_
# Configuración del portal de clientes (bpc_), en live.
STRIPE_TRAINER_PORTAL_CONFIGURATION_ID=bpc_
# Configuración de métodos de pago (pmc_): solo con stripe_tax. Con managed_payments se ignora (los elige Stripe).
STRIPE_TRAINER_PAYMENT_METHOD_CONFIGURATION_ID=

# Precios live (importes fijados en src/config.ts; el preflight comprueba que coinciden).
STRIPE_TRAINER_PRO_MONTHLY_PRICE_ID=price_
STRIPE_TRAINER_PRO_ANNUAL_PRICE_ID=price_
STRIPE_TRAINER_GROWTH_MONTHLY_PRICE_ID=price_
STRIPE_TRAINER_GROWTH_ANNUAL_PRICE_ID=price_
STRIPE_TRAINER_SCALE_MONTHLY_PRICE_ID=price_
STRIPE_TRAINER_SCALE_ANNUAL_PRICE_ID=price_

# CORS: la web de Trainers llama a la API desde otro dominio. Solo orígenes https exactos, separados por comas.
CORS_EXTRA_ORIGINS=https://trainers.trainfit.net
