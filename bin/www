require("dotenv").config();
const mongoose = require("mongoose");
mongoose.set("strictQuery", true);
const app = require("../app");
const { buildMongoUri, redactMongoUri } = require("../scripts/_mongo-uri");
const billingReconciliationJob = require("../components/billing/billing-reconciliation-job");
const { startCheckinReminderCron } = require("../components/trainerCheckins/checkin-reminder-cron");
const {
  startAnthropometryRequestReminderCron,
} = require("../components/anthropometryRequests/anthropometry-request-reminder-cron");
const { startCoachAlertCron } = require("../components/coachAlerts/coach-alert-cron");

// -------------------------------------------------------
// 🧩 Normalización del puerto
// -------------------------------------------------------
function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) return val; // named pipe
  if (port >= 0) return port; // port number
  return false;
}

const port = normalizePort(process.env.SERVER_PORT || 3000);
app.set("port", port);

// -------------------------------------------------------
// 🔧 Variables de entorno
// -------------------------------------------------------
const serverDomain = process.env.SERVER_DOMAIN;

// -------------------------------------------------------
// ⚙️ Construcción de la URI de conexión
// -------------------------------------------------------
const mongoURI = buildMongoUri();
const redactedMongoURI = redactMongoUri(mongoURI);
const mongoConnectOptions = {
  serverSelectionTimeoutMS: Number(
    process.env.MONGODB_SERVER_SELECTION_TIMEOUT_MS || 30000,
  ),
  connectTimeoutMS: Number(process.env.MONGODB_CONNECT_TIMEOUT_MS || 30000),
};

// -------------------------------------------------------
// 🚀 Conexión y arranque del servidor
// -------------------------------------------------------
mongoose.Promise = global.Promise;

function connectWithRetry() {
  console.log(`🔌 Connecting to MongoDB: ${redactedMongoURI}`);
  mongoose
    .connect(mongoURI, mongoConnectOptions)
    .then(() => {
      console.log("✅ Conexión a MongoDB establecida");
      const serv = app.listen(port, () => {
        console.log(`🚀 Server running at port: ${port}`);
      });
      serv.timeout = 300000;
      billingReconciliationJob.start();
      // PM2 arranca bin/www directamente (sin el prestart que compila el
      // módulo TypeScript de pagos). Sin .build fallan el borrado de cuentas y
      // las rutas de clientes de entrenador: se avisa alto y claro al arrancar.
      if (!require("fs").existsSync(require("path").join(__dirname, "../.build/trainer-billing/runtime.js"))) {
        console.error("❌ Falta .build/trainer-billing: ejecuta `npm run build:trainer-billing` antes de arrancar (ver docs/TRAINERS_PAGOS_PRODUCCION.md).");
      }
      require("../components/trainerBilling/adapter").start();
      // TASK-025 existía desde antes pero nunca se llamaba desde el
      // arranque real (confirmado por grep: cero require() del módulo
      // fuera de sí mismo) — el cron de recordatorios de check-in llevaba
      // construido pero inerte. Arrancado aquí junto al nuevo de medidas.
      startCheckinReminderCron();
      startAnthropometryRequestReminderCron();
      // Fase 1 Coach Pro — evaluador nocturno de señales que alimenta las
      // alertas del panel del profesional (05:00, ver coach-alert-cron.js).
      startCoachAlertCron();
    })
    .catch((err) => {
      console.error("❌ MongoDB error:", err.message);
      console.log("🔄 Reintentando en 5s...");
      setTimeout(connectWithRetry, 5000);
    });
}

connectWithRetry();
