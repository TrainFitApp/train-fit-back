# Copiar a .env.stripe.local (ignorado por Git). No usar la .env habitual.
TRAINER_BILLING_ENABLED=0
TRAINER_BILLING_MODE=test
# test_no_tax, stripe_tax o managed_payments (Stripe vende; actívalo antes en el sandbox: guía, A0).
TRAINER_BILLING_TAX_POLICY=test_no_tax
TRAINER_BILLING_FRONTEND_URL=http://localhost:8100
MONGODB_URI=mongodb://127.0.0.1:27017/trainfit_stripe_local
SERVER_PORT=3000

# Guardar credenciales solo en .env.stripe.local; preferir restricted key rk_test_.
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRAINER_PORTAL_CONFIGURATION_ID=

# Opcionales en el sandbox, obligatorios en live (ver docs/stripe-trainers-guia.md):
# configuración de métodos de pago (pmc_…), condiciones de contratación (https) y buzón de facturación.
STRIPE_TRAINER_PAYMENT_METHOD_CONFIGURATION_ID=
TRAINER_BILLING_TERMS_URL=
TRAINER_BILLING_SUPPORT_EMAIL=

# Identificadores públicos del catálogo de prueba confirmado; importes en céntimos EUR.
STRIPE_TRAINER_PRO_MONTHLY_PRICE_ID=price_1UGwy6AkRj4BmEBXuh3YQ81K
STRIPE_TRAINER_PRO_ANNUAL_PRICE_ID=price_1UGwy6AkRj4BmEBXLjhEYY3E
STRIPE_TRAINER_GROWTH_MONTHLY_PRICE_ID=price_1UGwzuAkRj4BmEBXnYS6eh0k
STRIPE_TRAINER_GROWTH_ANNUAL_PRICE_ID=price_1UGwzuAkRj4BmEBXywoJFCIk
STRIPE_TRAINER_SCALE_MONTHLY_PRICE_ID=price_1UGx1hAkRj4BmEBX8SacNQte
STRIPE_TRAINER_SCALE_ANNUAL_PRICE_ID=price_1UGx3GAkRj4BmEBXHozGPDoU

# Opcional: crea SOLO trainer@example.test en la BD aislada si todavía no existe.
# Al activar el seed, elegir una contraseña de prueba de al menos 12 caracteres.
TRAINER_BILLING_SEED_USER=0
TRAINER_TEST_PASSWORD=
