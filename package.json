  "dependencies": {
    "@awaitjs/express": "^0.6.1",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@types/node": "22.18.6",
    "axios": "^1.7.9",
    "bcrypt": "^5.0.1",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.0.1",
    "express": "^4.18.2",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "mongodb": "^4.4.1",
    "mongoose": "^6.2.9",
    "mongoose-autopopulate": "^0.16.1",
    "morgan": "~1.9.1",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.7.5",
    "semver": "^7.8.5",
    "stripe": "22.6.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "debug": "~2.6.9"
  }
}
